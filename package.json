{
  "name": "vieta-math",
  "version": "1.0.0",
  "private": false,
  "workspaces": [
    "latex-math-engine",
    "examples/*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "A reusable math editor library with LaTeX support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./prosemirror": {
      "types": "./dist/vieta-math-prosemirror.d.ts",
      "import": "./dist/vieta-math-prosemirror.mjs",
      "require": "./dist/vieta-math-prosemirror.js",
      "default": "./dist/vieta-math-prosemirror.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSES",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build:engine": "npm run build --workspace=latex-math-engine",
    "generate": "node scripts/generate-symbol-data.js",
    "prebuild": "npm run build:engine && npm run generate",
    "build": "webpack --mode production && webpack --env module --mode production",
    "build:dev": "npm run build:engine && npm run generate && webpack --mode development",
    "dev": "npm run build:dev",
    "test": "npm test --workspace=latex-math-engine",
    "test:browser": "playwright test",
    "build:examples": "npm run build --workspace=@vietamath/example-standalone --workspace=@vietamath/example-prosemirror --workspace=@vietamath/demo-site",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "math",
    "latex",
    "editor",
    "math-editor",
    "equation-editor"
  ],
  "author": "Liam Hawtin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liamhawtin/vieta-math.git"
  },
  "bugs": {
    "url": "https://github.com/liamhawtin/vieta-math/issues"
  },
  "homepage": "https://liamhawtin.github.io/vieta-math/",
  "dependencies": {
    "@tabler/icons-react": "^3.26.0",
    "mobx": "^6.10.2",
    "mobx-react-lite": "^4.0.5",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-env": "^7.22.20",
    "@babel/preset-react": "^7.22.15",
    "@playwright/test": "^1.62.1",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "markdown-it": "^14.1.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-state": "^1.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.69.0",
    "sass-embedded": "^1.91.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
