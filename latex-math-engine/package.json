{
  "name": "@liamhawtin/vieta-math-engine-internal",
  "version": "0.16.18",
  "private": true,
  "license": "MIT",
  "main": "dist/latex-math-engine.js",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "rimraf dist/ && mkdirp dist && rollup -c --bundleConfigAsCjs --failAfterWarnings && webpack"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-flow": "^7.27.1",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-flow": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "@babel/register": "^7.28.0",
    "@babel/runtime": "^7.28.0",
    "@rollup/plugin-alias": "^3.1.9",
    "@rollup/plugin-babel": "^5.3.1",
    "@xmldom/xmldom": "^0.8.11",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-preval": "^5.1.0",
    "babel-plugin-version-inline": "^1.0.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "json-stable-stringify": "^1.3.0",
    "mini-css-extract-plugin": "^2.9.2",
    "mkdirp": "^3.0.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.3.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.46.0",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/unicodeSymbols.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "**/test/*-spec.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "^katex$": "<rootDir>/katex.js"
    }
  }
}
